# Copiez ce fichier en .env pour un usage local (jamais commité).
# Clé API Mistral : https://console.mistral.ai/
MISTRAL_API_KEY=

# Publication Slack (requis en production ; le déploiement managé lit ces
# variables depuis les secrets de l'espace de travail Mistral).
# Créez un Slack App avec le scope chat:write et invitez le bot dans le canal.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Modèle utilisé pour la vérification croisée (optionnel)
NEWS_MODEL=mistral-medium-latest
